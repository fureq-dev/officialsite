# Google Forms 連携（README の手順で取得）
# 送信先: フォームURL末尾を /viewform から /formResponse に変えたもの
PUBLIC_GFORM_ACTION=https://docs.google.com/forms/d/e/XXXXXXXXXXXXXXXX/formResponse

# 各質問の entry ID（事前入力リンクから取得）
PUBLIC_GFORM_ENTRY_NAME=entry.0000000001
PUBLIC_GFORM_ENTRY_EMAIL=entry.0000000002
PUBLIC_GFORM_ENTRY_TYPE=entry.0000000003
PUBLIC_GFORM_ENTRY_MESSAGE=entry.0000000004

# 更新情報・テストプレイ登録フォーム（別の Google フォーム）
PUBLIC_GFORM_NOTIFY_ACTION=https://docs.google.com/forms/d/e/YYYYYYYYYYYYYYYY/formResponse
PUBLIC_GFORM_NOTIFY_ENTRY_EMAIL=entry.0000000011
PUBLIC_GFORM_NOTIFY_ENTRY_KIND=entry.0000000012
