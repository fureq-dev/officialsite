---
interface Props {
  label: string;
  title: string;
  lead?: string;
}
const { label, title, lead } = Astro.props;
---

<div class="grid grid-cols-1 gap-4 md:grid-cols-12 md:gap-8">
  <p class="meta md:col-span-3">{label}</p>
  <div class="md:col-span-9">
    <h2 class="text-3xl font-medium leading-snug md:text-4xl">{title}</h2>
    {lead && <p class="mt-4 max-w-[560px] text-base leading-8 text-ink-2">{lead}</p>}
  </div>
</div>
