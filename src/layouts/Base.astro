---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import HeaderDial from '../components/HeaderDial';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'FUREQ（フューレック）｜ゲームの面白さを追求する開発プロダクト',
  description = 'FUREQ は、ゲームの面白さを追求するゲーム開発プロダクトです。Fun・Uniqueness・Replayability・Excitement・Quest の5つを軸に開発しています。',
} = Astro.props;

// OGP の URL は絶対 URL が必要。astro.config の site（SITE_URL）を基準にする。
const origin = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(withBase('ogp-image.png'), origin).href;
const icon = withBase('icon.png');
const logo = withBase('logo.png');
const home = withBase('');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href={icon} />
    <link rel="apple-touch-icon" href={icon} />
    <meta name="theme-color" content="#ffffff" />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FUREQ" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&family=IBM+Plex+Sans+JP:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
    <noscript><style>[data-reveal]{opacity:1;transform:none}</style></noscript>
  </head>
  <body>
    <header class="sticky top-0 z-40 border-b border-line bg-paper">
      <div class="wrap flex h-16 items-center justify-between">
        <a href={home} class="flex items-center gap-3" aria-label="FUREQ ホーム">
          <img src={icon} alt="" width="28" height="28" class="h-7 w-7" />
          <span class="text-base font-medium">FUREQ</span>
        </a>
        <div class="flex items-center gap-6 md:gap-8">
          <nav aria-label="メイン" class="flex items-center gap-4 text-sm text-ink-2 md:gap-8">
            <a href={`${home}#index`} class="transition-colors hover:text-ink">Index</a>
            <a href={`${home}#titles`} class="transition-colors hover:text-ink">Titles</a>
            <a href={withBase('log/')} class="transition-colors hover:text-ink">Log</a>
            <a href={`${home}#contact`} class="transition-colors hover:text-ink">Contact</a>
          </nav>
          <div class="hidden md:block">
            <HeaderDial client:load transition:persist="header-dial" />
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-line bg-paper">
      <div class="wrap flex flex-col gap-2 py-8 md:flex-row md:items-center md:justify-between">
        <div class="flex items-center gap-3">
          <img src={logo} alt="FUREQ" class="h-10 w-auto" />
        </div>
        <div class="flex items-center gap-6">
          <a href={withBase('brand/')} class="text-sm text-ink-2 transition-colors hover:text-ink">ブランド素材</a>
          <p class="meta">© {new Date().getFullYear()} FUREQ</p>
        </div>
      </div>
    </footer>

    <script>
      // ClientRouter 使用時、通常の DOMContentLoaded は初回しか走らないため
      // astro:page-load でヒーローの入場アニメーションを毎回再実行する
      document.addEventListener('astro:page-load', () => {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
        els.forEach((el, i) => {
          el.classList.remove('is-in');
          el.style.setProperty('--d', `${i * 60}ms`);
        });
        requestAnimationFrame(() => {
          requestAnimationFrame(() => els.forEach((el) => el.classList.add('is-in')));
        });
      });
    </script>
  </body>
</html>
